      "Bash(port migrate*)",
      "Bash(port edit *)",
      "Bash(rustup install *)",
      "Bash(csrutil *)",
      "Bash(spctl *)",
      "Bash(systemsetup *)",
      "Bash(chsh)",
      "Bash(launchctl)",
      "Bash(sudo)",
      "Bash(doas)",
      "Bash(git push)",
      "Bash(brew ln *)",
      "Bash(brew up)",
      "Bash(brew up *)",
      "Bash(brew instal *)",
      "Bash(brew uninstal *)",
      "Bash(brew tap-new *)",
      "Bash(port unarchive *)",
      "Bash(rustup update*)",
      "Edit(./rust-toolchain.toml)",
      "Edit(./docs/spec/01-invariants.md)"
    ],
    "ask": [
      "Bash(git init*)"
    ],
    "allow": [
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git rev-parse *)",
      "Bash(git branch*)",
      "Bash(scripts/validate.sh*)",
      "Bash(./scripts/validate.sh*)",
      "Bash(scripts/run-fixture-matrix.sh*)",
      "Bash(scripts/generate-codex-layer.sh*)",
      "Bash(cargo run *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Bash(shasum *)",
      "Bash(df *)",
      "Bash(du *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.unicode.org)",
      "WebFetch(domain:formulae.brew.sh)",
      "WebFetch(domain:www.macports.org)",
      "Bash(brew --prefix*)",
      "Bash(brew --version*)",
      "Bash(brew config*)",
      "Bash(brew list *)",
      "Bash(brew leaves*)",
      "Bash(brew deps *)",
      "Bash(brew uses *)",
      "Bash(brew info *)",
      "Bash(brew outdated*)",
      "Bash(brew tap-info *)",
      "Bash(port version*)",
      "Bash(port installed*)",
      "Bash(port echo *)",
      "Bash(port deps *)",
      "Bash(port rdeps *)",
      "Bash(port dependents *)",
      "Bash(port rdependents *)",
      "Bash(port info *)",
      "Bash(port variants *)",
      "Bash(port outdated*)",
      "Bash(sw_vers*)",
      "Bash(uname *)",
      "Bash(sysctl -n *)",
      "Bash(arch)",
      "Bash(xcode-select -p*)",
      "Bash(shellcheck *)",
      "WebFetch(domain:docs.brew.sh)",
      "WebFetch(domain:trac.macports.org)",
      "WebFetch(domain:guide.macports.org)",
      "WebFetch(domain:ports.macports.org)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:code.claude.com)",
      "Bash(cargo fmt*)",
      "Bash(cargo check*)",
      "Bash(cargo build*)",
      "Bash(cargo clippy*)",
      "Bash(cargo test*)",
      "Bash(cargo tree*)",
      "Bash(cargo metadata*)",
      "Bash(cargo deny *)",
      "Bash(cargo about *)",
      "Bash(cargo nextest *)",
      "Bash(rustc --version*)",
      "Bash(rustc --print *)",
      "Bash(rustup show*)",
      "Bash(rustup target list*)",
      "Bash(otool -l *)",
      "Bash(vtool -show *)",
      "Bash(lipo -info *)",
      "Bash(file *)",
      "WebFetch(domain:docs.rs)",
      "Bash(shfmt -d *)",
      "Bash(shfmt -l *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "autoMemoryEnabled": false,
  "env": {
    "HOMEBREW_NO_AUTO_UPDATE": "1",
    "HOMEBREW_NO_ANALYTICS": "1",
    "HOMEBREW_NO_ENV_HINTS": "1",
    "MACPORTSBREW_AGENT_SESSION": "1",
    "CARGO_TERM_COLOR": "never"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session-start.sh",
            "timeout": 20,
            "statusMessage": "Loading MacPortsBrew pass context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/arm-guard-edit.sh",
            "timeout": 10,
            "statusMessage": "Checking the prompt for the guard-edit token"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-provider-mutation.sh",
            "timeout": 15,
            "statusMessage": "Checking command against INV-05 / INV-06"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/commit-gate.sh",
            "timeout": 1500,
            "statusMessage": "Validating before the commit"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-protected-paths.sh",
            "timeout": 15,
            "statusMessage": "Checking write target"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/post-edit-checks.sh",
            "timeout": 120,
            "statusMessage": "Formatting and checking the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/stop-gate.sh",
            "timeout": 600,
            "statusMessage": "Running the definition-of-done gate"
          }
        ]
      }
    ]
  }
}
