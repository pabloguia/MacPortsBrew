+             [ \"$(stat -f %Lp \"$HOME\")\" = 700 ] || exit 14\n\
+             [ \"$LANG$LC_ALL$TERM$NO_COLOR$PYTHONDONTWRITEBYTECODE\" = CCdumb11 ] || exit 15\n\
+             [ \"$1\" = --version ] && [ $# = 1 ] || exit 16\n\
+             case \"$HOME\" in '{probes}'/probe-*) ;; *) exit 17 ;; esac\n\
+             [ \"${{PATH%%:*}}\" = '{bin}' ] || exit 18\n\
+             [ \"${{PATH#*:}}\" = /usr/bin:/bin:/usr/sbin:/sbin ] || exit 19\n\
