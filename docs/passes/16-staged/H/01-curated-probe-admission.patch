+    fn write_executable(path: &Path, text: &str) {
+        if text.is_empty() {
+            std::fs::copy("/usr/bin/true", path).expect("copy");
+        } else {
+            std::fs::write(path, text).expect("write");
+        }
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o755)).expect("mode");
+    }
