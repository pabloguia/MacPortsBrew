+# Manual only, by the owner's decision of 2026-10-17 (SE-099), kept by DP-039
+# (b) ("before any automatic trigger returns"). The gate refuses every event
+# other than a dispatch. That is not a formality to be relaxed by adding a
+# trigger: on a `pull_request` event GITHUB_SHA is the merge commit and the
+# workflow file itself comes from the pull request ([GH-EVT], pull_request),
+# so the gate below would be the pull request's own copy. Restoring a trigger
+# needs a new design, not an edit here; scripts/test-gates.sh asserts the
+# trigger list and the gate's refusal.
 on:
   workflow_dispatch:
     inputs:
       prompt:
-        description: "What Claude should do (it has no comment to read)"
+        description: "What Claude should do (read-only: it can read and inspect git, nothing else)"
         required: true
         type: string
+      pr_number:
+        description: "Optional: a pull request of THIS repository whose head Claude should examine (in work/)"
+        required: false
+        type: string
+        default: ""
 
+# Nothing at workflow level: each job states its own, and none can write.
+permissions: {}
+
 jobs:
+  # DP-039 (b).1 and (b).3, before any secret exists in any job. This job holds
+  # no secret and selects no environment, so a refusal here happens before the
+  # `claude` environment's reviewer is even asked, and the job below never
+  # starts (`needs: gate`).
+  gate:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: read
+      pull-requests: read
+    outputs:
+      base_sha: ${{ steps.check.outputs.base_sha }}
+      head_sha: ${{ steps.check.outputs.head_sha }}
+    steps:
+      - id: check
+        shell: bash
+        # Every value reaches the script through `env:`, never through a `${{ }}`
+        # inside `run:`, so nothing an author controls (an input, a branch name)
+        # is ever spliced into shell text.
+        env:
+          GH_TOKEN: ${{ github.token }}
+          EVENT_NAME: ${{ github.event_name }}
+          REPO: ${{ github.repository }}
+          REF: ${{ github.ref }}
+          SHA: ${{ github.sha }}
+          ACTOR: ${{ github.actor }}
+          ACTOR_ID: ${{ github.actor_id }}
+          TRIGGERING_ACTOR: ${{ github.triggering_actor }}
+          OWNER: ${{ github.repository_owner }}
+          OWNER_ID: ${{ github.repository_owner_id }}
+          PR_NUMBER: ${{ inputs.pr_number }}
+        run: |
+          set -euo pipefail
+          refuse() { echo "::error title=DP-039 (b) refused::$*"; exit 1; }
+          lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
+
+          # H3 of the part M review: a dispatch, and nothing else (see `on:`).
+          [ "$EVENT_NAME" = workflow_dispatch ] || refuse "event is not workflow_dispatch; this gate accepts nothing else"
+
+          repo_json="$(gh api "repos/$REPO")"
+          owner_type="$(jq -r '.owner.type // ""' <<<"$repo_json")"
+          default_branch="$(jq -r '.default_branch // ""' <<<"$repo_json")"
+          [[ "$default_branch" =~ ^[A-Za-z0-9._/-]+$ ]] || refuse "unreadable default branch"
+
+          # DP-039 (b).3 - OWNER or MEMBER, with the meaning GitHub gives the
+          # association values (OWNER: owns the repository; MEMBER: member of
+          # the organization that owns it).
+          #  - Personal repository: the login must be the owner's. For
+          #    github.actor the account IDs are compared as well, so a renamed
+          #    account cannot match by name ([GH-CTX]: actor_id,
+          #    repository_owner_id).
+          #  - Organization repository: GET /orgs/{org}/members/{user} must
+          #    answer exactly 204 ([GH-ORG]). Its documented answers are 204
+          #    (member), 404 (not a member) and 302 when the requester is not a
+          #    member - which the job's GITHUB_TOKEN is not, so a member whose
+          #    membership is private may be refused. That is a fail-closed
+          #    refusal, never an acceptance; only 204 passes. Whether `gh`
+          #    follows the 302 to the public-membership endpoint is UNVERIFIED.
+          owner_or_member() { # <login>
+            local login="$1" status=""
+            [ -n "$login" ] || return 1
+            case "$owner_type" in
+              User) [ "$(lc "$login")" = "$(lc "$OWNER")" ] ;;
+              Organization)
+                status="$(gh api -i "orgs/$OWNER/members/$login" 2>/dev/null | awk 'NR == 1 && /^HTTP/ { print $2 }')" || true
+                [ "$status" = 204 ] ;;
+              *) return 1 ;;
+            esac
+          }
+
+          # GitHub already requires write access to dispatch ([ACT]
+          # docs/security.md, which is also why the action itself checks
+          # nothing for this event). Write access is wider than OWNER or
+          # MEMBER, so the narrower test is made here, for the actor and for
+          # whoever re-ran the job ([GH-CTX]: a re-run keeps github.actor's
+          # privileges but may be started by another github.triggering_actor).
+          owner_or_member "$ACTOR" || refuse "dispatched by $ACTOR, who is neither the owner nor a verified member"
+          if [ "$owner_type" = User ] && [ "$ACTOR_ID" != "$OWNER_ID" ]; then
+            refuse "dispatching account id does not match the owner's"
+          fi
+          owner_or_member "$TRIGGERING_ACTOR" || refuse "re-run by $TRIGGERING_ACTOR, who is neither the owner nor a verified member"
+
+          # DP-039 (b).2, the half GitHub decides: a dispatch runs the workflow
+          # file of the ref it was dispatched on ([GH-EVT]: GITHUB_REF is the
+          # branch or tag that received the dispatch), so a branch could carry
+          # a copy of this file with the gate removed. Only the default branch
+          # is accepted here, and the `claude` environment's deployment-branch
+          # rule (owner's setting, point 5) refuses the key to any other ref
+          # even if this check were edited out on that branch.
+          [ "$REF" = "refs/heads/$default_branch" ] || refuse "dispatch from a ref other than refs/heads/$default_branch, which alone carries the reviewed workflow and configuration"
+          [[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || refuse "unreadable commit"
+          head_sha=""
+
+          # DP-039 (b).1 - a pull request's head must be this repository. The
+          # API answer is used, not an input. A deleted fork reads as an empty
+          # head repository and is refused. The number is validated before it
+          # appears in any message.
+          if [ -n "$PR_NUMBER" ]; then
+            [[ "$PR_NUMBER" =~ ^[0-9]+$ ]] || refuse "the pull request number is not a number"
+            pr_json="$(gh api "repos/$REPO/pulls/$PR_NUMBER")"
+            base_repo="$(jq -r '.base.repo.full_name // ""' <<<"$pr_json")"
+            head_repo="$(jq -r '.head.repo.full_name // ""' <<<"$pr_json")"
+            pr_association="$(jq -r '.author_association // ""' <<<"$pr_json")"
+            [ -n "$base_repo" ] && [ "$(lc "$base_repo")" = "$(lc "$REPO")" ] || refuse "pull request #$PR_NUMBER does not target $REPO"
+            [ -n "$head_repo" ] && [ "$(lc "$head_repo")" = "$(lc "$REPO")" ] || refuse "pull request #$PR_NUMBER comes from another repository"
+            # DP-039 (b).3 for the text Claude reads (H1 of the part M review):
+            # the pull request must have been opened by OWNER or MEMBER, so the
+            # head is not an outsider's prompt next to the key. REMAINING GAP,
+            # stated rather than hidden: this bounds who opened the pull
+            # request, not who pushed each commit to its branch - anyone with
+            # write access may push to a same-repository branch. The dispatcher
+            # (OWNER/MEMBER, above) is the one who vouches for the head.
+            case "$pr_association" in
+              OWNER|MEMBER) ;;
+              *) refuse "pull request #$PR_NUMBER was opened by an author whose association is not OWNER or MEMBER" ;;
+            esac
+            head_sha="$(jq -r '.head.sha // ""' <<<"$pr_json")"
+            [[ "$head_sha" =~ ^[0-9a-f]{40}$ ]] || refuse "unreadable head commit for #$PR_NUMBER"
+          fi
+
+          # Commits, not refs, go forward: what was checked here is what the
+          # next job checks out, even if the branch moves in between.
+          {
+            echo "base_sha=$SHA"
+            echo "head_sha=$head_sha"
+          } >>"$GITHUB_OUTPUT"
