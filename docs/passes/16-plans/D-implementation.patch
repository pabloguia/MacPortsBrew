+        }
+        assert_eq!(cellar.answer("svc", &[]), Answer::Unknown, "no version");
+    }
+
+    #[test]
+    fn a_cellar_that_is_a_symlink_is_unknown() {
+        let cellar = Cellar::new("linked");
+        cellar.keg("svc", "1.0");
