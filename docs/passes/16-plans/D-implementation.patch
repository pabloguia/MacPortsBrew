+        );
+    }
+
+    #[test]
+    fn more_entries_than_a_keg_has_is_unknown_not_truncated() {
+        let cellar = Cellar::new("crowded");
+        let keg = cellar.keg("svc", "1.0");
+        for n in 0..MAX_KEG_ENTRIES {
+            std::fs::write(keg.join(format!("f{n}")), "").unwrap();
+        }
