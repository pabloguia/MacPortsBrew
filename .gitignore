# Personal Claude Code overrides. Project rules belong in .claude/settings.json.
.claude/settings.local.json
.claude/agent-memory/

# Session state for the guarded-path escape: which prompt armed it, and every
# write it let through. Both are per-session facts about one machine, and the
# log is the evidence an end-of-pass report cites rather than a thing to keep.
.claude/.guard-edit-marker
.claude/.guard-edit-log*

# Worktrees Claude Code makes for isolated subagents. Untracked, one of these
# made the commit gate read a docs-only commit as touching `.claude` and run
# the full validation, past what the app waits for.
.claude/worktrees/

# Local research and capture scratch. Committed fixtures live under tests/.
docs/research/.scratch/

# macOS
.DS_Store

# Build output (Rust; ADR-0002)
/target/
/dist/

# Personal per-project notes for Claude Code (loaded after CLAUDE.md, never committed).
CLAUDE.local.md

# Local tooling caches (token-pilot).
.token-pilot/

# A hand-written Codex copy of the one skill the generator deliberately does not
# derive (scripts/generate-codex-layer.sh, SKILLS_NOT_GENERATED); not versioned here.
.agents/skills/tooling-recheck/
